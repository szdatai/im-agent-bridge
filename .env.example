# ==========================================================
# WeCom ↔ Claude Code Bridge 配置模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略,永不提交。
# ==========================================================

# ── 必填:企业微信智能机器人凭据 ──
# 获取方式:企业微信管理后台 → 应用管理 → 智能机器人
#   → 开启 API 模式 → 选择「长连接」→ 获取 BotID 和 Secret
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# ── 必填:只响应的企微用户 userid(逗号分隔)──
# 让机器人接收一条消息,bridge 日志会打印 senderId;或从企微后台用户详情查询。
# 白名单外的用户消息将被忽略(不回复)。
WECOM_ALLOWLIST=

# ── 可选:限定可响应的会话 chatid(逗号分隔);留空则不限制 ──
WECOM_ALLOW_CHATIDS=

# ── Claude Code 无头 agent 的工作目录(目标项目)──
# .env 由 bridge 从自身目录自动读取,与启动 cwd 无关。
# 留空默认取本目录的上一级;若 bridge 是独立工具(不在目标项目内),
# 请显式填目标项目绝对路径,如:WORK_DIR=D:/datai/datai-erp
WORK_DIR=

# ── 权限 ──
# acceptEdits = 自动接受文件编辑;破坏性命令由 disallowedTools + canUseTool 拦截。
# 如需更严格(每个命令都经 canUseTool 正则审查),可改为 default。
PERMISSION_MODE=acceptEdits

# ── 健康检查 HTTP 端口(127.0.0.1)──
BRIDGE_PORT=18794

# ── 并发控制 ──
MAX_CONCURRENT=3        # 全局同时处理的 agent 数量上限
QUEUE_MAX_DEPTH=5       # 单会话排队上限,超出丢最旧
AGENT_TIMEOUT_MS=180000 # 单次 agent 调用超时(毫秒)
MAX_TURNS=40            # agent 最大工具调用轮数

# ── 模型认证(可选)──
# 留空则自动读取 ~/.claude/settings.json 的 ANTHROPIC_* env 块兜底。
# 通常与 Claude Code 日常使用同一套 DeepSeek/Anthropic 端点即可。
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=deepseek-v4-flash[1M]
