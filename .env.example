# ==========================================================
# IM ↔ Claude Code Bridge 配置模板
# 复制为 .env 后填写真实值。.env 已被 .gitignore 忽略,永不提交。
# .env 由 bridge 从自身目录自动读取,与启动 cwd 无关。
# ==========================================================

# ── 启用通道(逗号分隔):wecom / dingtalk / wechat / feishu ──
# 未配置凭据的通道会被自动跳过(不影响其他通道)。
ENABLED_CHANNELS=wecom,dingtalk,wechat,feishu

# ── 全局白名单(可选)──
# 通道没有自己的 ALLOWLIST 时回落到这里;两者都为空则 fail-closed(不响应任何人)。
# ALLOWLIST=

# ── 企业微信(凭据其一)──
# 获取:企微后台 → 应用管理 → 智能机器人 → API 模式 → 长连接 → BotID + Secret
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_ALLOWLIST=        # 允许的企微 userid(逗号分隔)
WECOM_ALLOW_CHATIDS=    # 可选:限定会话 chatid

# ── 钉钉(可选)──
# 获取:钉钉开放平台 → 应用开发 → 企业内部应用 → AppKey + AppSecret
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALLOWLIST=     # 允许的钉钉 userid(senderStaffId,逗号分隔)
DINGTALK_ALLOW_CHATIDS=

# ── 微信 iLink(可选,账号文件驱动)──
# 扫码登录生成账号文件(iLink token),放进 WECHAT_ACCOUNTS_DIR;
# 进程 10s 扫描目录,新账号自动拉起。可复用既有 iLink 账号目录。
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com
WECHAT_ACCOUNTS_DIR=    # 留空默认 <项目>/wechat-accounts/(gitignore)
WECHAT_ALLOWLIST=       # 允许的微信 wxid(逗号分隔)
WECHAT_ALLOW_CHATIDS=

# ── 飞书(可选)──
# 获取:飞书开放平台 → 开发者后台 → 自建应用 → 凭证与基础信息 → App ID + App Secret
# 需开通「机器人」能力,并在事件订阅中添加 im.message.receive_v1(长连接模式)。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWLIST=       # 允许的飞书用户 open_id(逗号分隔;非白名单消息会打日志便于抓取)
FEISHU_ALLOW_CHATIDS=

# ── Claude Code 无头 agent 的工作目录(目标项目)──
# 若 bridge 是独立工具(不在目标项目内),请显式填目标项目绝对路径。
# 如:WORK_DIR=D:/datai/datai-erp
WORK_DIR=

# ── 权限 ──
# acceptEdits = 自动接受文件编辑;破坏性命令由 disallowedTools + canUseTool 拦截。
PERMISSION_MODE=acceptEdits

# ── 健康检查 HTTP 端口(127.0.0.1)──
BRIDGE_PORT=18794

# ── 并发控制 ──
MAX_CONCURRENT=3        # 全局同时处理的 agent 数量上限
QUEUE_MAX_DEPTH=5       # 单 通道+会话 排队上限,超出丢最旧
AGENT_TIMEOUT_MS=180000 # 单次 agent 调用超时(毫秒)
MAX_TURNS=40            # agent 最大工具调用轮数

# ── 模型认证(可选)──
# 留空则自动读取 ~/.claude/settings.json 的 ANTHROPIC_* env 块兜底。
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_MODEL=deepseek-v4-flash[1M]
